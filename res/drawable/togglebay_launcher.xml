<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#12233F"
                android:endColor="#2468A2" />
        </shape>
    </item>
    <item android:left="12dp" android:top="15dp" android:right="12dp" android:bottom="15dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#F4F7FA" />
        </shape>
    </item>
    <item android:left="17dp" android:top="20dp" android:right="31dp" android:bottom="31dp">
        <shape android:shape="oval">
            <solid android:color="#2468A2" />
        </shape>
    </item>
    <item android:left="31dp" android:top="31dp" android:right="17dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#12233F" />
        </shape>
    </item>
</layer-list>
