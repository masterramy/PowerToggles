<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Independent ToggleDeck mark: a compact 2x2 control deck with one active tile. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#202124" />
            <padding android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp" />
        </shape>
    </item>

    <item android:left="12dp" android:top="12dp" android:right="38dp" android:bottom="38dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#F1F3F4" />
        </shape>
    </item>
    <item android:left="38dp" android:top="12dp" android:right="12dp" android:bottom="38dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#8AB4F8" />
        </shape>
    </item>
    <item android:left="12dp" android:top="38dp" android:right="38dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#BDC1C6" />
        </shape>
    </item>
    <item android:left="38dp" android:top="38dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#F1F3F4" />
        </shape>
    </item>

    <!-- Small active-state indicator on the highlighted control tile. -->
    <item android:left="49dp" android:top="22dp" android:right="20dp" android:bottom="49dp">
        <shape android:shape="oval">
            <solid android:color="#202124" />
        </shape>
    </item>
</layer-list>
